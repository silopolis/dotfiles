#!/usr/bin/env -S usage bash
#MISE description="Clean up merged worktrees: verify the merge into main (git or a merged pull request), then run scm:worktree:rm"
#MISE alias="scm:wt:done"
#USAGE arg "[target]" help="Stem, name, branch or path; omit with --all-merged"
#USAGE flag "--all-merged" help="Clean every clean worktree whose branch has commits of its own, merged into main"
#USAGE flag "--force" help="Skip the checks of a target and discard (same as scm:worktree:rm --force)"
#USAGE flag "--keep-tab" help="Do not close the herdr tab"
# Merged: the branch tip is in origin/main, or GitHub has a merged pull request from the
# branch into main whose head commit is the local tip (squash and rebase merges).
# A branch with no commits of its own since its start is never cleaned as merged: it would
# look merged, being an ancestor of origin/main; remove it with scm:worktree:rm.
# shellcheck shell=bash
set -euo pipefail

# shellcheck disable=SC1091
source "${MISE_CONFIG_DIR:-$HOME/.config/mise}/lib/scm.sh"

here=$(dirname "$(readlink -f "$0")")
rm_task=$here/rm
[[ -x $rm_task ]] || rm_task=$here/executable_rm
[[ -x $rm_task ]] || scm_die "cannot find the sibling task scm:worktree:rm"

src=$(scm_origin_dir)
main=$(scm_preflight "$src")

git -C "$main" fetch --quiet origin 2>/dev/null || scm_warn "could not fetch origin; checking against the local origin/main"
git -C "$main" rev-parse --verify --quiet origin/main >/dev/null || scm_die "origin/main does not exist"

rm_args=(--reason "done")
[[ -n ${usage_force:-} ]] && rm_args+=(--force)
[[ -n ${usage_keep_tab:-} ]] && rm_args+=(--keep-tab)

clean_one() { # path
  "$rm_task" "$1" "${rm_args[@]}" </dev/null
}

if [[ -n ${usage_all_merged:-} ]]; then
  [[ -z ${usage_target:-} ]] || scm_die "give a target or --all-merged, not both"
  done_count=0 skipped=0
  skip() { scm_info "skip $1: $2"; skipped=$((skipped + 1)); }
  # Read the whole list first: the steps below run commands that could read stdin.
  mapfile -t lines < <(git -C "$main" worktree list --porcelain; echo)
  path='' branch=''
  for line in "${lines[@]}"; do
    case $line in
      "worktree "*) path=${line#worktree }; branch='' ;;
      "branch "*) branch=${line#branch refs/heads/} ;;
      "")
        if [[ -n $path && $path != "$main" && -n $branch ]]; then
          name=$(basename "$path")
          own=0
          scm_own_commits "$main" "$path" "$branch" || own=$?
          if ((own == 1)); then
            skip "$name" "'$branch' has no commits of its own"
          elif ((own == 2)); then
            skip "$name" "cannot tell whether '$branch' has commits of its own (clean it with: mise run scm:worktree:done $name)"
          elif [[ -n $(git -C "$path" status --porcelain 2>/dev/null) ]]; then
            skip "$name" "uncommitted or untracked files"
          else
            rc=0
            proof=$(scm_merged "$main" "$branch") || rc=$?
            if ((rc != 0)); then
              skip "$name" "'$branch' is not in origin/main and has no merged pull request with the same head$(scm_merged_hint "$rc")"
            else
              scm_info "$name: merged ($proof)"
              clean_one "$path" && done_count=$((done_count + 1))
            fi
          fi
        fi
        path=''
        ;;
    esac
  done
  scm_info "done: $done_count cleaned, $skipped skipped"
  exit 0
fi

target=${usage_target:-}
[[ -n $target ]] || scm_die "give a target, or --all-merged"
rc=0
found=$(scm_find_worktree "$main" "$target") || rc=$?
((rc == 0)) || scm_die "$([[ $rc -eq 2 ]] && echo "'$target' matches several worktrees" || echo "no worktree matches '$target'")"
IFS=$'\t' read -r path branch <<<"$found"

if [[ -z ${usage_force:-} ]]; then
  [[ -n $branch ]] || scm_die "worktree $path has no branch (detached HEAD); remove it with: mise run scm:worktree:rm $(basename "$path")"
  own=0
  scm_own_commits "$main" "$path" "$branch" || own=$?
  ((own != 1)) || scm_die "branch '$branch' has no commits of its own, so there is nothing merged to clean; remove it with: mise run scm:worktree:rm $(basename "$path")"
  rc=0
  proof=$(scm_merged "$main" "$branch") || rc=$?
  ((rc == 0)) || scm_die "branch '$branch' is not in origin/main and has no merged pull request with the same head$(scm_merged_hint "$rc"): merge it first (or use --force to discard)"
  scm_info "$(basename "$path"): merged ($proof)"
fi
clean_one "$path"
